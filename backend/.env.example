# Copy to .env (in THIS folder, next to manage.py) and adjust. Never commit the real .env file.
#
# Precedence, highest first:
#   1. a real environment variable with a NON-EMPTY value (deployment platform, Docker, your shell's `export`)
#   2. the value in backend/.env
#   3. the default in config/settings.py (only for settings that have one)
# An EMPTY variable inherited from the shell/IDE counts as "not set", so it cannot hide a value written here.
# Write plain NAME=value lines: no quotes, no spaces around "=", saved as plain UTF-8 text.
# Check what Django sees with:  python manage.py check
# If DJANGO_SECRET_KEY is empty in development, a random per-process key is generated.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origin(s) of the React app (comma separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Fraud model (XGBoost) ---------------------------------------------------
# Set to false to switch fraud analysis off. Payments are then held as "fraud verification unavailable"
# (they are NOT approved without verification).
FRAUD_MODEL_ENABLED=True
# Folder holding the model artifacts. Default: fraud_model/aligned next to manage.py. Keep it private.
# FRAUD_MODEL_DIR=
# INR per 1 USD, REQUIRED. PaySafe stores and shows INR everywhere; the XGBoost model was trained on
# USD-scale amounts (IEEE-CIS TransactionAmt), so the backend divides the INR amount by this rate ONLY
# when preparing the model input. The stored/displayed amount is never changed. 85 is an EXAMPLE:
# choose the rate your organisation accepts. With no value every payment is held as "unavailable".
FRAUD_INR_PER_USD=85
# High-risk threshold (0-1): probability >= threshold is HIGH risk, below is LOW. Leave empty to use the
# value chosen on the Phase 1 validation data (about 0.1055, see fraud_model/aligned/model_metadata.json).
# Only the server decides risk; the browser cannot change this. (Legacy name FRAUD_MODEL_THRESHOLD still works.)
HIGH_RISK_THRESHOLD=

# --- One-time code (OTP) -----------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300            # lifetime of one code
OTP_MAX_ATTEMPTS=5                # wrong guesses allowed per code
OTP_MAX_RESENDS=3                 # extra codes after the first, per payment
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_USER_PER_HOUR=10      # code e-mails per user per hour, across payments
VERIFICATION_WINDOW_SECONDS=1800  # a payment waiting longer than this is cancelled

# --- E-mail (Django e-mail framework) ------------------------------------------
# One-time codes and high-risk alerts are sent ONLY to the signed-in user's registered e-mail address, from
# DEFAULT_FROM_EMAIL. If sending fails the API reports it, the code is invalidated and nothing is claimed as sent.
# There is NO automatic fallback from SMTP to the console backend.

# ---- Option A: local development (active below) --------------------------------------------------------------
# The console backend prints each e-mail, INCLUDING THE ONE-TIME CODE, to the terminal running `runserver`.
# Development only: never use it in production (with DJANGO_DEBUG=False, `manage.py check` reports an error).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=PaySafe <no-reply@paysafe.local>

# ---- Option B: real delivery through Gmail SMTP ----------------------------------------------------------------
# To use it, comment out Option A above, uncomment this block and put the app password on the EMAIL_HOST_PASSWORD
# line. Gmail needs 2-Step Verification on the account and a 16-character Google App Password (your normal Gmail
# password is rejected: https://myaccount.google.com/apppasswords). Never commit it or paste it into chat or code.
# Gmail sends only as the authenticated account, so DEFAULT_FROM_EMAIL must be that same address.
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=harperl0304@gmail.com
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=True
#EMAIL_USE_SSL=False
#EMAIL_TIMEOUT=10
#DEFAULT_FROM_EMAIL=harperl0304@gmail.com
