# Copy to .env and adjust. Never commit the real .env file.
# If DJANGO_SECRET_KEY is empty in development, a random per-process key is generated.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origin(s) of the React app (comma separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
